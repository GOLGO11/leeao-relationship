t":"许水德","relation":"国家赔偿诉讼/律师代理对市府法定代理人","weight":4,"note":"《鸟政府，赔钱来》《一元官司》写龙云翔律师代理李敖向台北市政府请求国家赔偿，《控告台北市政府四文件》又明列被告为台北市政府法定代理人许水德，形成市府查扣书籍诉讼主线。"},{"book":"李敖闹衙集","source":"苏南成","target":"王聪琰","relation":"高雄查扣案/市长与警员责任链","weight":4,"note":"《又一元官司》写警员王聪琰查扣《我给我画帽子》，李敖随后致函高雄市长苏南成，指其有假借职权、教唆下属非法扣押之嫌，是高雄国家赔偿案的责任链。"},{"book":"李敖闹衙集","source":"邵玉铭","target":"吴三连","relation":"出版法规对照/新闻局与自立发行人","weight":2,"note":"《邵玉铭不守出版法规！》从吴三连死后《自立晚报》《自立早报》发行人登记问题切入，转批新闻局长邵玉铭不按出版登记法规办事，二人构成出版法规论证中的对照端点。"},{"book":"李敖闹衙集","source":"林振国","target":"陈冲","relation":"保险法监管/财政部长与保险司长","weight":4,"note":"《谁不执行〈保险法〉？》收信人为财政部长林振国、保险司长陈冲，要求财政部查明国泰人寿拖延理赔，二人是保险监管压力线的官方端点。"},{"book":"李敖闹衙集","source":"蔡万霖","target":"蔡宏图","relation":"国泰人寿理赔争议/名誉董事长与董事长","weight":3,"note":"同篇副本列国泰人寿名誉董事长蔡万霖、董事长蔡宏图、总经理范光煌，围绕苏荣泉身故保险理赔争议构成公司负责人链。"},{"book":"李敖闹衙集","source":"蔡宏图","target":"范光煌","relation":"国泰人寿理赔争议/董事长与总经理并列","weight":3,"note":"《谁不执行〈保险法〉？》把蔡宏图、范光煌同列为国泰人寿副本收受者，要求对拖延赔偿问题负责，二人构成公司内部责任端点。"},{"book":"李敖闹衙集","source":"苏荣泉","target":"蔡万霖","relation":"保险理赔争议/被害人投保与国泰负责人","weight":4,"note":"苏荣泉在国泰人寿投保后于泰国遇害，家属申请理赔迟未获付，李敖将国泰人寿蔡万霖等列为追责对象，构成本书保险法支线。"},{"book":"李敖闹衙集","source":"苏荣泉","target":"林振国","relation":"保险法催讨/家属授权与财政部监管","weight":3,"note":"书中称苏荣泉家属授权李敖代为催讨，函请财政部长林振国、保险司长陈冲查明七日内答复，连接被害人保险权益与财政部监管。"},{"book":"李敖闹衙集","source":"萧同兹","target":"萧孟能","relation":"父子/水晶大厦与合作金库债务源头","weight":5,"note":"多篇《代萧孟能闹金衙/银衙》均以先严萧同兹、萧孟能继承和水晶大厦贷款问题为起点，父子关系是本书金融衙门争讼主干。"},{"book":"李敖闹衙集","source":"萧孟能","target":"朱婉坚","relation":"水晶大厦债务/家属作保与抵押卷入","weight":5,"note":"《代萧孟能闹金衙》写合作金库情商代解困难，朱婉坚出面作保后被卷入抵押贷款房产问题，是萧孟能债务案中的核心家庭与财产端点。"},{"book":"李敖闹衙集","source":"萧同兹","target":"张荫如","relation":"三井工程贷款/第二保证人与主债务人","weight":4,"note":"书中反复称萧同兹应三井工程负责人张荫如之请，为该公司向合作金库信用贷款作第二保证人，后续争议由此展开。"},{"book":"李敖闹衙集","source":"张荫如","target":"杨冠洲","relation":"三井工程贷款/主债务人与第一保证人","weight":3,"note":"同一说明称三井工程信用贷款的第一保证人为杨冠洲，萧同兹为第二保证人，张荫如与杨冠洲构成原始贷款责任链。"},{"book":"李敖闹衙集","source":"朱婉坚","target":"赵庆云","relation":"合作金库抵押/转请提供吴兴街房产","weight":4,"note":"《代萧孟能闹金衙》写朱婉坚为涂销设定，商请赵庆云提供吴兴街房产以应合作金库强索，形成无辜第三者被套住的抵押支线。"},{"book":"李敖闹衙集","source":"朱婉坚","target":"萧广仁","relation":"台北市银行清偿方案/贷款转移家属","weight":3,"note":"《代萧孟能再闹金衙》《代萧孟能闹银衙》引清偿债务办法，要求将全部贷款转移至家属朱婉坚与萧广仁两人名下，以结清萧同兹生前悬案。"},{"book":"李敖闹衙集","source":"萧广仁","target":"萧近仁","relation":"国防部福利总处/土地持分补足赠与","weight":3,"note":"《跟国防部打笔仗》写不足土地持分原属萧广仁名下，后改由萧近仁名下土地以赠与方式补足，成为国防部福利总处扣押权状争议的技术端点。"},{"book":"李敖闹衙集","source":"陈介摩","target":"黄盛泉","relation":"国防部福利总处/上校与代书办理涂销","weight":4,"note":"《跟国防部打笔仗》称福利总处派陈介摩上校、土地代书黄盛泉前往办理水晶大厦二楼建物与土地抵押权涂销，二人构成国防部福利总处手续链。"},{"book":"李敖闹衙集","source":"朱婉坚","target":"黄盛泉","relation":"权状抵押手续/业主与指定代书","weight":3,"note":"同篇协调记录要求业主朱婉坚提供文件盖章，并由国防部福利总处认定代书办理，后文多次出现黄盛泉代书函稿，二人连接业主与手续执行。"},{"book":"李敖闹衙集","source":"萧孟能","target":"陈子和","relation":"台北市银行债务/董事长侧面致函","weight":3,"note":"《代萧孟能闹银衙》写台北市银行董事长侧面致函陈子和，称萧君提出清付利息计划后延滞金可从优考虑，用以套使萧孟能承认利息。"},{"book":"李敖闹衙集","source":"吴越潮","target":"朱婉坚","relation":"水晶住户交涉/贷款与延滞金支线","weight":3,"note":"《代萧孟能再闹金衙》《代萧孟能闹银衙》写朱婉坚等清偿方案后，经水晶住户吴越潮等多次交涉，台北市银行才同意延滞违约金免计。"},{"book":"李敖闹衙集","source":"江鹏坚","target":"刘会云","relation":"立委质询/受托检举行政院押租","weight":5,"note":"《吴祺芳怎样作弄江鹏坚？》写江鹏坚不负刘会云所托，函告已就行政院以巨额公款为死人押租豪华大厦提出质询，是行政院押租案的问政主线。"},{"book":"李敖闹衙集","source":"刘会云","target":"陈苾仙","relation":"押租检举/房主债务与行政院续租","weight":4,"note":"刘会云检举行政院押租陈苾仙名下豪华大厦，且陈苾仙对萧孟能负有债务，二人构成押租、债权和拍卖妨碍交叉线。"},{"book":"李敖闹衙集","source":"陈苾仙","target":"叶公超","relation":"行政院押租/叶公超原住用房屋","weight":4,"note":"行政院回信称叶公超任政务委员时因宿舍不足，押租陈苾仙房屋供叶公超住用；叶公超去世后押租仍延续，成为江鹏坚质询焦点。"},{"book":"李敖闹衙集","source":"陈苾仙","target":"唐家宜","relation":"房主代理/退租押金交涉","weight":3,"note":"行政院回函称房主陈苾仙侨居智利，其在台代理人唐家宜虽一再允诺办理退租押金，却以另觅押租人不易为由拖延。"},{"book":"李敖闹衙集","source":"吴祺芳","target":"江鹏坚","relation":"行政院秘书处回函/太极拳作弄质询","weight":5,"note":"《吴祺芳怎样作弄江鹏坚？》明说江鹏坚收到行政院回信后被吴祺芳作弄，李敖指出秘书处回函幕后正是副秘书长吴祺芳。"},{"book":"李敖闹衙集","source":"吴祺芳","target":"陈苾仙","relation":"行政院押租续住/看管房屋真相","weight":4,"note":"行政院称陈苾仙房屋押租金无法收回而须派人看管，遂由吴祺芳住入；李敖批评实为吴祺芳要住这房子，连接副秘书长与房主押租争议。"},{"book":"李敖闹衙集","source":"吴祺芳","target":"孙运璿","relation":"行政院副秘书长/孙院长赏识与任用","weight":3,"note":"《中央日报》称吴祺芳在孙运璿任行政院长时任副秘书长，深得孙院长赏识；后文又称吴氏由孙运璿推荐给俞国华。"},{"book":"李敖闹衙集","source":"吴祺芳","target":"俞国华","relation":"延长服务/俞院长倚重挽留","weight":3,"note":"书中引《中央日报》《中国时报》称吴祺芳在俞国华挽留下继续担任行政院副秘书长，并由俞国华倚重延长服务。"},{"book":"李敖闹衙集","source":"吴祺芳","target":"王章清","relation":"行政院秘书处/正副秘书长协作","weight":3,"note":"《中国时报》引文称吴祺芳应行政院长俞国华及秘书长王章清之请延长服务，并经常代表王章清主持跨部会协调会议。"},{"book":"笑傲六十年·有话说李敖","source":"萧同兹","target":"萧孟能","relation":"父子/文星书店出资与经营线","weight":5,"note":"2009-08-04 集明说萧同兹拿钱给儿子萧孟能、儿媳妇朱婉坚在衡阳路开文星书店，并称萧同兹与萧孟能父子赏识李敖；本边记录文星起点的家族经营关系。"},{"book":"笑傲六十年·有话说李敖","source":"萧孟能","target":"朱婉坚","relation":"夫妻/文星书店共同经营线","weight":4,"note":"2009-08-04 集把萧孟能、朱婉坚并列为萧同兹出资开办文星书店的儿子和儿媳妇，二人共同构成本书文星书店的经营端点。"},{"book":"笑傲六十年·有话说李敖","source":"萧同兹","target":"朱婉坚","relation":"公媳/文星书店出资开办线","weight":3,"note":"2009-08-04 集称萧同兹拿钱给儿子萧孟能和儿媳妇朱婉坚开文星书店；本边补齐文星开办叙述中的家族端点。"},{"book":"中国迷信新研","source":"蒋经国","target":"蒋介石","relation":"祖坟被毁记载/《我的父亲》线索","weight":4,"note":"同篇写文化大革命中蒋介石祖坟被毁，并引蒋经国《我的父亲》记蒋介石闻讯苦痛。"},{"book":"中国现代史定论","source":"萧同兹","target":"萧孟能","relation":"文星接管/父承子业","weight":4,"note":"同篇记文星书店《傅斯年选集》付梓时，文星被蒋介石下条子改组，萧同兹父承子业接管萧孟能，并迫于警总压力删稿。"},{"book":"李敖书序集","source":"萧同兹","target":"萧孟能","relation":"父子/文星督导管束","weight":3,"note":"同篇所引呈文要求萧同兹对其子萧孟能严加督导管束，是文星事件中的父子与出版控制线。"},{"book":"李敖对话录","source":"朱婉坚","target":"萧孟能","relation":"夫妻名义/文星权利争议","weight":4,"note":"《书店升天，作者扫地》明说萧孟能和朱婉坚至今仍是夫妻，但文星书店独资与出版权利归朱婉坚所有。"},{"book":"李敖情书集","source":"刘会云","target":"萧孟能","relation":"告发与债权纠纷/寄会云书信线","weight":5,"note":"《寄会云》集中谈刘会云、萧孟能与外汇支票、债权和告发纠纷，属于情书集后段的现实法律财务线。"},{"book":"李敖书信集","source":"刘会云","target":"江鹏坚","relation":"选区公民陈情/行政院押租案","weight":5,"note":"《“吴代叶僵”探秘》说明刘会云身为江鹏坚选区公民，写信请江鹏坚质询行政院为叶公超宿舍预付押租的问题。"},{"book":"李敖书信集","source":"叶公超","target":"陈苾仙","relation":"政务委员宿舍押租/房屋业主","weight":5,"note":"同信追问行政院为叶公超租住大厦并预付租金与押租，房屋业主为陈苾仙，行政院公文曾误写为陈宓仙。"},{"book":"李敖书信集","source":"陈苾仙","target":"唐家宜","relation":"房主与在台代理人/押租退还交涉","weight":5,"note":"行政院回复称陈苾仙侨居智利，由在台代理人唐家宜处理提前退租、另觅新押租人和押租退还等事。"},{"book":"李敖书信集","source":"叶公超","target":"吴祺芳","relation":"吴代叶僵/死后宿舍由副秘书长住入","weight":6,"note":"同信标题即以“吴代叶僵”概括叶公超死后宿舍未退，改由行政院吴祺芳副秘书长住入并看管的争议。"},{"book":"李敖书信集","source":"吴祺芳","target":"陈苾仙","relation":"住入看管与提前续约/押租争议","weight":5,"note":"同案中吴祺芳住入看管叶公超旧宿舍，而陈苾仙一方因合约与押租安排无法立即提前退租，构成公款押租争议链。"},{"book":"李敖书信集","source":"江鹏坚","target":"吴祺芳","relation":"行政院质询/副秘书长占房案","weight":5,"note":"江鹏坚受刘会云陈情向行政院质询，问题焦点落在吴祺芳接住并看管叶公超旧宿舍是否形成公款占房。"},{"book":"李敖书简集","source":"萧孟能","target":"周其新","relation":"支票十三张/萧案证据链","weight":4,"note":"《给黄少谷先生的公开信》专列“周其新签发之支票十三张”部分，周其新成为萧孟能案中支票证据链的核心人物。"},{"book":"李敖书简集","source":"萧孟能","target":"朱婉坚","relation":"夫妻分产/残余产权估计","weight":4,"note":"李敖反驳萧孟能估计财产时指出，残余部分产权三楼为朱婉坚所有，且朱婉坚与萧孟能早在1980年已夫妻分产。"},{"book":"李敖书笺集","source":"萧孟能","target":"刘会云","relation":"文星登记/诉讼与告发线","weight":6,"note":"《从主流到乱流》写刘会云申请《文星》登记，并在萧孟能窃占案中向地检处告发，是文星与房产诉讼链的关键人物。"},{"book":"李敖书笺集","source":"江鹏坚","target":"刘会云","relation":"选区公民/行政院公帑质询","weight":4,"note":"《手下·下手·快》称刘会云为江鹏坚选区公民，写信揭发行政院为叶公超死后仍押租豪华大厦一事。"},{"book":"李敖书笺集","source":"苏南成","target":"王聪琰","relation":"高雄市府查扣/出版法处分","weight":4,"note":"《致“台湾第一不要脸”书》称苏南成下属王聪琰以违反《出版法》为由扣押《我给我画帽子》。"},{"book":"李敖书笺集","source":"苏南成","target":"孙慧珍","relation":"书籍销售点/市府查扣线","weight":3,"note":"同篇写《我给我画帽子》委托高雄盐埕区孙慧珍代售，随后遭苏南成市府查扣。"},{"book":"李敖书启集","source":"徐进业","target":"朱婉坚","relation":"不动产买卖/产权旁证","weight":5,"note":"同函附1977年徐进业与朱婉坚不动产买卖契约书，反驳洪贵参律师函所谓法院拍卖说。"},{"book":"李敖书启集","source":"陈良榘","target":"龙云翔","relation":"回函律师地址/诉讼联络","weight":3,"note":"《代胡学古复洪贵参律师函》和《李敖警告金兰大厦CD座邻居》均列陈良榘、龙云翔、郭鑫生等律师地址作为回函或诉讼联络处。"},{"book":"李敖札记","source":"江鹏坚","target":"俞国华","relation":"立法院程序争议/施政报告","weight":5,"note":"《拉着他》记江鹏坚抗议行政院长俞国华未依法提前送交施政方针报告，并在院会中提出程序问题。"},{"book":"孙中山研究","source":"孙中山","target":"蒋介石","relation":"追随与信札/陈炯明事件中地位高涨","weight":5,"note":"同篇写陈炯明事件使蒋介石在孙中山心目中地位高涨，并引孙中山写给许崇智、蒋介石的信，勉其不可遽怀退志。"},{"book":"闽变研究与文星讼案","source":"萧孟能","target":"吴相湘","relation":"文星出版/丛书主编责任","weight":4,"note":"《现代史料丛书》由文星发行、吴相湘主编，萧孟能作为文星发行人与吴相湘共同处在丛书责任链上。"},{"book":"大江大海骗了你","source":"萧孟能","target":"朱婉坚","relation":"夫妻/文星权益委托","weight":5,"note":"同篇称朱婉坚为萧孟能太太，李敖受其委托处理文星旧约与著作权争议。"},{"book":"蒋介石评传","source":"蒋介石","target":"孙中山","relation":"提拔与继承宣传/孙蒋关系反历史","weight":8,"note":"第二章写蒋介石后来因孙中山提拔而走运，并把自己与孙挂钩、塑造成孙中山合法接班人；李敖则批评国民党剪接孙蒋一对一形象。"},{"book":"蒋介石评传","source":"蒋介石","target":"罗斯福","relation":"开罗会议/四强地位由罗斯福提升","weight":8,"note":"第七章写罗斯福为战后亚洲秩序提升中国国际地位，才使蒋介石得以赴开罗会议，与英美元首共同商讨战略和善后问题。"},{"book":"蒋介石评传","source":"蒋介石","target":"蒋经国","relation":"父子威权/台湾继承与特务统治","weight":9,"note":"第十一章写蒋氏父子在台湾形成政治高压，蒋经国一手掌管党政特务机构；并强调蒋介石与戴笠是主仆，与经国则是父子关系。"},{"book":"蒋介石评传","source":"萧同兹","target":"蒋介石","relation":"蒋方代表/中原大战拉张学良","weight":4,"note":"第四章写张学良进关拥蒋并非单纯择木而栖，而是蒋方代表吴铁城、萧同兹的外交手腕胜出。"},{"book":"蒋介石评传","source":"叶公超","target":"蒋介石","relation":"对日和约外交/赔偿放弃争议","weight":4,"note":"第十一章写叶公超在对日和约非正式会谈中提出自动放弃赔偿以换取其他条件，成为蒋介石对日外交死要面子的执行端点。"},{"book":"蒋介石研究","source":"蒋介石","target":"孙中山","relation":"谒见年表/唯一继承人宣传争议","weight":7,"note":"《蒋介石是哪一年见孙中山的？》围绕蒋介石初见孙中山的年份与国民党塑造孙中山唯一继承人的宣传展开考证。"},{"book":"蒋介石研究","source":"蒋介石","target":"萧同兹","relation":"中央社出面邀请美国记者/演假戏安排","weight":6,"note":"《蒋介石怎样指导演假戏？》写有人建议蒋介石邀请美国记者来台，政府不宜出面，遂决定由中央社社长萧同兹出面。"},{"book":"蒋介石研究","source":"蒋介石","target":"蒋经国","relation":"父子/长子过继安排","weight":6,"note":"同篇以蒋介石《亡弟瑞青哀状》说明，蒋介石把长子蒋经国过继给亡弟蒋周传。"},{"book":"蒋介石研究三集","source":"蒋介石","target":"蒋经国","relation":"父子/祖坟被毁记载","weight":4,"note":"《蒋介石与祖坟》写文化大革命中蒋介石祖坟被毁，并引蒋经国《我的父亲》记蒋介石闻讯苦痛。"},{"book":"蒋介石研究五集","source":"蒋介石","target":"孙中山","relation":"永丰舰共患难/救孙宣传争议","weight":7,"note":"《蒋介石在现场救孙中山？》围绕蒋介石是否在现场救孙中山展开，李敖以永丰舰共患难名单拆解国民党宣传。"},{"book":"蒋介石研究六集","source":"蒋介石","target":"孙中山","relation":"小辫子/陈其美伏线与革命继承","weight":8,"note":"《蒋介石抓住孙中山小辫子》明说蒋介石与孙中山的关系得力于陈其美伏线，并以陶成章案解释蒋介石后来裹胁孙中山的微妙关系。"},{"book":"蒋介石研究六集","source":"萧孟能","target":"朱婉坚","relation":"夫妻/文星书店共同经营","weight":5,"note":"《蒋介石与〈文星〉》写萧孟能经营文星，萧太太朱婉坚亲自照顾衡阳街店面，后来文星决定由朱婉坚赴香港书展。"},{"book":"蒋介石研究六集","source":"萧同兹","target":"萧孟能","relation":"父子/文星出面整理与督导管束","weight":8,"note":"同篇明写萧孟能的老子是国民党萧同兹，萧同兹后来上报告称将负责整理文星，并对长子孟能言行负责督导管束。"},{"book":"蒋介石研究六集","source":"蒋介石","target":"萧同兹","relation":"文星停刊转圜/上报告获批试办","weight":8,"note":"同篇写蒋介石下达封闭手令后，萧同兹上报告请求负责整理文星；张群签呈后蒋介石批示“可如拟试办”。"},{"book":"蒋介石研究六集","source":"朱婉坚","target":"萧孟能","relation":"香港书展代行/文星夫妇线","weight":4,"note":"同篇写国民党决定不让萧孟能赴香港书展，最后文星决定由萧孟能太太朱婉坚去，但国民党拖到书展结束才准其离境。"},{"book":"蒋经国研究","source":"蒋经国","target":"蒋介石","relation":"父子与政治继承/台湾权力交接","weight":10,"note":"本书多处以蒋氏父子并论，江南《蒋经国身前身后》更明说蒋介石把台湾权力顺利交给爱子经国，形成本书最核心的父子与继承边。"},{"book":"蒋经国研究","source":"蒋经国","target":"俞国华","relation":"行政院长/江南十信案责任与后蒋科技官僚","weight":4,"note":"《蒋经国澄清了些什么？》并列蒋经国、俞国华未对江南案和十信案负行政责任，《谁是蒋经国的接班人？》又把俞国华列入科技官僚接班评估。"},{"book":"论定蒋经国","source":"蒋经国","target":"蒋介石","relation":"父子世袭/蒋家王朝与总统传位","weight":10,"note":"《蒋介石不如崇祯、蒋经国不如阿斗》以蒋介石太子蒋经国之死起笔，批评民国总统沦为父死子继的蒋氏家天下，是本书最核心的父子王朝边。"},{"book":"论定蒋经国","source":"俞国华","target":"蒋经国","relation":"遗嘱见证/行政院院长","weight":4,"note":"遗嘱状列俞国华为行政院院长被告之一，又在林洋港谈话中写其已到会客室并参与五院院长签名见证。"},{"book":"论定蒋经国","source":"蒋经国","target":"孙中山","relation":"中山大学与三民主义/革命正统背景","weight":4,"note":"《蒋经国在莫斯科》称莫斯科中山大学以完成孙中山未竟之业为名，又围绕三民主义与蒋介石是否继承孙中山路线展开辩论。"},{"book":"论定蒋经国","source":"吴三连","target":"蒋经国","relation":"亲民秀评价/无党无派人士颂词","weight":3,"note":"《论定蒋经国》批评吴三连称蒋经国仁民爱物、功在国家，认为这类颂词源自蒋经国亲民秀与个人崇拜。"},{"book":"国民党研究","source":"蒋介石","target":"孙中山","relation":"变造照片/唯一心腹宣传","weight":5,"note":"《国民党与变造照片》写黄埔军校合照中蒋介石与孙中山、何应钦、王柏龄同在，后来被浓出成孙中山、蒋介石两人合照，以加强蒋介石是孙中山唯一心腹的宣传效果。"},{"book":"国民党臭史","source":"蒋介石","target":"孙中山","relation":"初见年代/革命年表争议","weight":4,"note":"同篇以蒋介石何时初见孙中山为争点，批评秦孝仪捏造年代以改写蒋介石革命资历。"},{"book":"国民党臭史","source":"蒋介石","target":"蒋经国","relation":"父子相承/国民党统治报应","weight":5,"note":"《国民党的报应》写蒋介石统治中国和台湾四十七年，蒋经国统治台湾十三年，父子相承六十年，作恶账目落到国民党头上。"},{"book":"给国民党难看","source":"孙中山","target":"蒋介石","relation":"戒严样板/青出于蓝","weight":4,"note":"同篇写孙中山以杨希闵为戒严总司令时，蒋介石看在眼里一学就会并青出于蓝，形成戒严传统承袭边。"},{"book":"给外省人难看","source":"蒋介石","target":"蒋经国","relation":"胜利后政局类比/上海打虎王牌","weight":3,"note":"同篇余政宪质询中把抗战胜利后蒋介石政权腐败与推出蒋经国收拾上海大老虎相连，作为郝柏村处境的历史类比。"},{"book":"给外省人难看","source":"邵玉铭","target":"蒋介石","relation":"禁蒋介石研究书/文字警察秘密函","weight":4,"note":"《邵玉铭与军阀》写新闻局局长邵玉铭秘密函请警察机关处理李敖所著蒋介石研究系列，成为解严后文字警察例证。"},{"book":"给外省人难看","source":"邵玉铭","target":"蒋经国","relation":"禁蒋经国研究书/文字警察秘密函","weight":4,"note":"同篇秘密公文并列《蒋经国研究》，以先总统蒋公及蒋总统经国先生事迹为由请警察依法处理。"},{"book":"给外省人难看","source":"吴祺芳","target":"叶公超","relation":"官邸续租/行政院押租公产","weight":4,"note":"《吴祺芳的“内线交易”》写吴祺芳住的官邸本是行政院为叶公超押租，叶死后未退租反由吴祺芳住进。"},{"book":"给外省人难看","source":"萧孟能","target":"朱婉坚","relation":"文星书店经营/夫妇与版权转让","weight":4,"note":"同篇写文星书店由朱婉坚独资经营，后来萧孟能在朱婉坚未授权情况下把文星部分书卖给大林书店。"},{"book":"冷眼看台湾","source":"苏南成","target":"蒋经国","relation":"劝进投票/党外投机批评","weight":3,"note":"同篇以苏南成为党外投机例子，说党外人物从劝进蒋经国到投票蒋经国，借苏南成模式批评低三下四。"},{"book":"冷眼看台湾","source":"萧孟能","target":"朱婉坚","relation":"婚姻分居/文星创业与诽谤争议","weight":5,"note":"《法律的问题，法律解决》逐项反驳吴祥辉说李敖为萧孟能向朱婉坚献策，并说明朱婉坚曾辛苦帮萧孟能创业，协议分居并非李敖介入。"},{"book":"冷眼看台湾","source":"吴越潮","target":"萧孟能","relation":"协议分居见证人/李敖未介入证据","weight":3,"note":"同篇写协议分居书上的见证人明明是吴越潮、陈子和、郑锡华、张任飞，用以证明李敖根本不肯介入萧孟能、朱婉坚分居。"},{"book":"冷眼看台湾","source":"陈子和","target":"萧孟能","relation":"协议分居见证人/李敖未介入证据","weight":3,"note":"陈子和与吴越潮等同列为萧孟能、朱婉坚协议分居书见证人，是反驳李敖协助支持说的证据端点。"},{"book":"冷眼看台湾","source":"张任飞","target":"萧孟能","relation":"协议分居见证人/李敖未介入证据","weight":3,"note":"张任飞与吴越潮、陈子和、郑锡华并列为协议分居书见证人，形成萧孟能婚姻争议中的低频证据节点。"},{"book":"冷眼看台湾","source":"刘会云","target":"萧孟能","relation":"窃占土地检举/畸零地案","weight":4,"note":"《道德与法律之间》引吴祥辉说李敖由刘会云出面检举萧孟能窃占土地，李敖将其列为诽谤他教唆主持犯罪的一项。"}],"books":[{"book":"李敖闹衙集","collection":"雷霆法律类","chapters":17,"personCount":63,"people":[{"name":"萧孟能","count":259},{"name":"萧同兹","count":72},{"name":"朱婉坚","count":44},{"name":"吴祺芳","count":28},{"name":"江鹏坚","count":26},{"name":"陈苾仙","count":24},{"name":"叶公超","count":21},{"name":"蒋介石","count":19},{"name":"陈子和","count":18},{"name":"刘会云","count":15},{"name":"邵玉铭","count":13},{"name":"萧广仁","count":12},{"name":"黄盛泉","count":11},{"name":"张荫如","count":11},{"name":"蒋经国","count":10},{"name":"罗斯福","count":9},{"name":"赵庆云","count":9},{"name":"徐进业","count":8},{"name":"王聪琰","count":7},{"name":"郑玉波","count":7},{"name":"萧近仁","count":7},{"name":"龙云翔","count":5},{"name":"叶肇模","count":5},{"name":"唐家宜","count":5},{"name":"蔡万霖","count":4},{"name":"苏荣泉","count":4},{"name":"杨冠洲","count":4},{"name":"吴越潮","count":4},{"name":"黄章一","count":3},{"name":"吴三连","count":3},{"name":"潘君密","count":3},{"name":"蔡宏图","count":3},{"name":"高玉树","count":3},{"name":"孙德耕","count":3},{"name":"陈良榘","count":3},{"name":"孙运璿","count":3},{"name":"王章清","count":3},{"name":"苏南成","count":2},{"name":"廖兆祥","count":2},{"name":"李文锦","count":2},{"name":"王砚青","count":2},{"name":"竺道生","count":2},{"name":"孙中山","count":2},{"name":"林振国","count":2},{"name":"范光煌","count":2},{"name":"陈冲","count":2},{"name":"陈介摩","count":2},{"name":"周其新","count":2},{"name":"吴相湘","count":2},{"name":"张任飞","count":2},{"name":"汪慧云","count":2},{"name":"黄武弘","count":2},{"name":"黄陈二","count":2},{"name":"左潞生","count":2},{"name":"俞国华","count":2},{"name":"黄玉娇","count":1},{"name":"孙慧珍","count":1},{"name":"邓维桢","count":1},{"name":"许水德","count":1},{"name":"朱汇森","count":1},{"name":"连战","count":1},{"name":"李宜琛","count":1},{"name":"侯家国","count":1}]}]}